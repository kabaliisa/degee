{
  "expo": {
    "name": "Deegee",
    "slug": "deegee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.deegee"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070706",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.deegee"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static",
      "name": "Deegee",
      "shortName": "Deegee",
      "description": "Buy music straight from Ugandan artists with mobile money. Yours to keep.",
      "themeColor": "#0A0A09",
      "backgroundColor": "#0A0A09",
      "display": "standalone",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#F0A519",
          "defaultChannel": "deegee-money"
        }
      ]
    ],
    "scheme": "deegee",
    "backgroundColor": "#0A0A09"
  }
}
